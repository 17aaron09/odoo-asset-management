<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="asset_main_view_list" model="ir.ui.view">
        <field name="name">asset.master.main.list</field>
        <field name="model">asset.master.main</field>
        <field name="arch" type="xml">
            <list string="Asset List">
                <field name="asset_code" width="120px"/>
                <field name="asset_name" width="220px"/>
                <field name="asset_category" width="120px"/>
                <field name="total_quantity" width="120px"/>
                <field name="available_quantity"/>
            </list>
        </field>
    </record>

    <record id="asset_main_view_form" model="ir.ui.view">
        <field name="name">asset.master.main.form</field>
        <field name="model">asset.master.main</field>
        <field name="arch" type="xml">
            <form string="Asset List">
                <sheet>
                    <group>
                        <field name="asset_code"/>
                        <field name="asset_name"/>
                        <field name="asset_category"/>
                        <field name="total_quantity"/>
                        <field name="available_quantity" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="asset_main_action" model="ir.actions.act_window">
        <field name="name">Asset Main</field>
        <field name="res_model">asset.master.main</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
