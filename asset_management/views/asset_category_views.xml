<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="asset_category_view_list" model="ir.ui.view">
        <field name="name">asset.master.category.list</field>
        <field name="model">asset.master.category</field>
        <field name="arch" type="xml">
            <list string="Asset Categories">
                <field name="category_code"/>
                <field name="category_name"/>
            </list>
        </field>
    </record>

    <record id="asset_category_view_form" model="ir.ui.view">
        <field name="name">asset.master.category.form</field>
        <field name="model">asset.master.category</field>
        <field name="arch" type="xml">
            <form string="Asset Category">
                <sheet>
                    <group>
                        <field name="category_code"/>
                        <field name="category_name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="asset_category_action" model="ir.actions.act_window">
        <field name="name">Asset Categories</field>
        <field name="res_model">asset.master.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
