<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_asset_management" model="ir.module.category">
        <field name="name">Asset Management</field>
    </record>

    <record id="privilege_asset_main" model="res.groups.privilege">
        <field name="name">Asset Main CRUD</field>
        <field name="category_id" ref="module_category_asset_management"/>
        <field name="placeholder">No Access</field>
    </record>

    <record id="group_asset_main_read" model="res.groups">
        <field name="name">Read Only</field>
        <field name="privilege_id" ref="privilege_asset_main"/>
    </record>

    <record id="group_asset_main_edit" model="res.groups">
        <field name="name">Create &amp; Edit</field>
        <field name="privilege_id" ref="privilege_asset_main"/>
        <field name="implied_ids" eval="[(4, ref('group_asset_main_read'))]"/>
    </record>

    <record id="group_asset_main_full" model="res.groups">
        <field name="name">Full Access</field>
        <field name="privilege_id" ref="privilege_asset_main"/>
        <field name="implied_ids" eval="[(4, ref('group_asset_main_edit'))]"/>
    </record>

    <record id="privilege_asset_borrow" model="res.groups.privilege">
        <field name="name">Asset Borrowing</field>
        <field name="category_id" ref="module_category_asset_management"/>
        <field name="placeholder">No Access</field>
    </record>

    <record id="group_asset_borrow_read" model="res.groups">
        <field name="name">Read Only</field>
        <field name="privilege_id" ref="privilege_asset_borrow"/>
    </record>

    <record id="group_asset_borrow_edit" model="res.groups">
        <field name="name">Create &amp; Edit</field>
        <field name="privilege_id" ref="privilege_asset_borrow"/>
        <field name="implied_ids" eval="[(4, ref('group_asset_borrow_read'))]"/>
    </record>

    <record id="group_asset_borrow_full" model="res.groups">
        <field name="name">Full Access</field>
        <field name="privilege_id" ref="privilege_asset_borrow"/>
        <field name="implied_ids" eval="[(4, ref('group_asset_borrow_edit'))]"/>
    </record>
    
    <record id="privilege_asset_categories" model="res.groups.privilege">
        <field name="name">Asset Categories</field>
        <field name="category_id" ref="module_category_asset_management"/>
        <field name="placeholder">No Access</field>
    </record>

    <record id="group_asset_category_read" model="res.groups">
        <field name="name">Read Only</field>
        <field name="privilege_id" ref="privilege_asset_categories"/>
    </record>

    <record id="group_asset_category_edit" model="res.groups">
        <field name="name">Create &amp; Edit</field>
        <field name="privilege_id" ref="privilege_asset_categories"/>
        <field name="implied_ids" eval="[(4, ref('group_asset_category_read'))]"/>
    </record>

    <record id="group_asset_category_full" model="res.groups">
        <field name="name">Full Access</field>
        <field name="privilege_id" ref="privilege_asset_categories"/>
        <field name="implied_ids" eval="[(4, ref('group_asset_category_edit'))]"/>
    </record>
</odoo>